# Copie este archivo como .env.demo. Vite lo usa solo con --mode demo.
# Estas dos variables son públicas; no agregue service_role ni contraseñas.
VITE_DEMO_SUPABASE_URL=https://SU_PROYECTO_DEMO.supabase.co
VITE_DEMO_SUPABASE_ANON_KEY=

# La migración 13 forma parte de la instalación completa de Demo.
VITE_DEMO_INVENTORY_ADMIN_ENABLED=true
VITE_DEMO_OPERATIONAL_COMPLETION_ENABLED=true
VITE_DEMO_BUSINESS_COMPLETION_ENABLED=true
